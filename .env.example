APP_NAME=AI Career Assistant
APP_ENV=development
APP_DEBUG=false
DEFAULT_TEMPLATE=professional

# Copy this file to .env and fill in the real values for your local environment.
# Do not commit .env to source control.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Must be a strong HS256 secret. Prefer a generated 32+ character value.
SUPABASE_JWT_SECRET=replace_with_a_strong_supabase_jwt_secret
# If the database password contains special characters such as @, URL-encode them.
# Example: postgres:your%40password@db.your-project.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your%40password@db.your-project.supabase.co:5432/postgres

# Model inference
HF_TOKEN=your_huggingface_token

# Job provider configuration (German market).
# arbeitsagentur + arbeitnow are free and need no credentials;
# adzuna needs a free App ID/Key from developer.adzuna.com;
# remotive is opt-in. Comma-separated, queried in parallel.
JOB_PROVIDER=arbeitsagentur,arbeitnow
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# Job search cache TTL in seconds (default: 3600 = 1 hour).
JOB_CACHE_TTL_SECONDS=3600

# CORS (§26): comma-separated explicit origin allowlist. No wildcards.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Observability & security (§12, §28)
# Requests per minute per client IP; health/readiness probes are exempt.
# 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=600
# Structured JSON log verbosity: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
