APP_NAME=AI Career Assistant
APP_ENV=development
APP_DEBUG=false
DEFAULT_TEMPLATE=professional

# Copy this file to .env and fill in the real values for your local environment.
# Do not commit .env to source control.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Must be a strong HS256 secret. Prefer a generated 32+ character value.
SUPABASE_JWT_SECRET=replace_with_a_strong_supabase_jwt_secret
# If the database password contains special characters such as @, URL-encode them.
# Example: postgres:your%40password@db.your-project.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your%40password@db.your-project.supabase.co:5432/postgres

# Model inference
HF_TOKEN=your_huggingface_token

# --- Ollama (local inference, no API key, no billing) ---
USE_OLLAMA=true
# Pinned image tag for docker-compose (never "latest": a silent image bump must
# not change model behaviour). Override to test a different Ollama release.
OLLAMA_IMAGE_TAG=0.40.3
OLLAMA_BASE_URL=http://localhost:11434   # in Docker: http://ollama:11434
OLLAMA_MODEL=llama3.2:3b                 # alternatives: mistral:7b, qwen3:8b
OLLAMA_TIMEOUT_SECONDS=10
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TEMPERATURE=0.3
# Context window (tokens) requested per Ollama call. Clamped once at runtime to
# the context length the pulled model actually reports (integer, minimum 512).
OLLAMA_NUM_CTX=8192
# Optional: protect a tunneled Ollama endpoint. Both must be set to send the header.
OLLAMA_AUTH_HEADER=
OLLAMA_AUTH_TOKEN=

# Job provider configuration (German market).
# arbeitsagentur + arbeitnow are free and need no credentials;
# adzuna needs a free App ID/Key from developer.adzuna.com;
# remotive is opt-in. Comma-separated, queried in parallel.
JOB_PROVIDER=arbeitsagentur,arbeitnow
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# Job search cache TTL in seconds (default: 3600 = 1 hour).
JOB_CACHE_TTL_SECONDS=3600
# Alias for JOB_PROVIDER (both names are accepted).
JOB_PROVIDERS=
# Default maximum posting age in days for every job provider (0 disables it).
JOB_DEFAULT_RECENCY_DAYS=30

# CORS (§26): comma-separated explicit origin allowlist. No wildcards.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Observability & security (§12, §28)
# Requests per minute per client IP; health/readiness probes are exempt.
# 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=600
# Structured JSON log verbosity: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# --- Model routing and discovery -------------------------------------------
# Enable the dynamic Hugging Face model discovery (network call at startup).
AI_ENABLE_DISCOVERY=true
# The search query the discovery uses.
AI_DISCOVERY_QUERY=instruct
# How many candidates the discovery keeps per task.
AI_DISCOVERY_LIMIT=20
# Maximum parameter count of a discovered model; 0 means no limit.
AI_MAX_PARAMETERS=0
# Comma-separated model ids the operator approves on top of the curated registry.
# Leave empty to use only the curated models.
AI_APPROVED_MODEL_IDS=
# How many models the router may try before it gives up on a task.
AI_MAX_FALLBACK_DEPTH=5
# Optional JSON object with the routing weights (task, language, quality, speed).
# Leave empty for the built-in weights.
ROUTING_WEIGHTS=
# Operator-reviewed model list and cached discovery results. Defaults live in
# ~/.config/ai-career-assistant/ (model_overrides.json / discovered_models.json);
# see docs/development/setup.md §8 (Model CLI). Point these at project-local
# files to review models before they become routable.
AI_MODEL_OVERRIDES_FILE=
AI_DISCOVERED_MODELS_FILE=

# --- Context and token budget ----------------------------------------------
# Extra tokens added to the computed required_context before a request is sent.
CONTEXT_SAFETY_MARGIN=256
# Alternative name for the Hugging Face token (HF_TOKEN is read first).
HUGGINGFACE_TOKEN=
# Alternative name for the database URL (SUPABASE_DB_URL is read first).
DATABASE_URL=
